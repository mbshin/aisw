#!/usr/bin/env bash
# aisw = the manager; an agent's name = start that agent.
# Start Claude Code on the first account that is not used up; when that account hits its limit
# and you /exit, go on with the same conversation on the next free account.
#
# Start agents:
#   aisw claude [a|b|c] [claude args...]  first free account (a first), or force one
#   aisw codex | agy             hand this folder's newest Claude session to Codex / Antigravity (fallback.sh)
#   aisw a|b|c ..., aisw -x ...  same as aisw claude ... (kept for old scripts)
#   aisw claude --dry-run [...]  print the command instead of running it
# Manage:
#   aisw                         dashboard (same as aisw ui)
#   aisw help | -h               this list
#   aisw status                  show all accounts
#   aisw who                     show who is logged in to each account
#   aisw login [a|b|c|codex|agy]  log in to one account (or Codex / Antigravity), or to every missing account
#   aisw ui | u                  dashboard of the three accounts (start, login, reset limit)
#   aisw resume [words]          pick a past conversation (any folder) with fzf, resume it on a free account
#   aisw setup | unsetup         make the account folders + status line + limit hook / take them out again
#   aisw test-hit a|b|c [dir]    pretend an account just hit its limit (to try a switch)
. "$(dirname "$0")/common.sh"
. "$(dirname "$0")/fallback.sh"

CLAUDE_BIN=${AISW_CLAUDE:-claude}
WAIT=${AISW_WAIT:-3}
RESUME_PROMPT="The previous turn was cut off by the usage limit and this session moved to another account. \
Run git status and git diff, check what was half done, then continue the task."

upper() { tr '[:lower:]' '[:upper:]' <<<"$1"; }

show_status() {
  local acct until
  for acct in $ACCOUNTS; do
    until=$(blocked_until "$acct")
    if [ -n "$until" ]; then
      echo "$(upper "$acct"): used up until $(hhmm "$until")"
    elif [ -f "$STATE/$acct.usage.json" ]; then
      echo "$(upper "$acct"): free ($(jq -r '"5h \(.five_hour.used_percentage // "?")% · 7d \(.seven_day.used_percentage // "?")%"' "$STATE/$acct.usage.json"))"
    else
      echo "$(upper "$acct"): free (no usage seen yet)"
    fi
  done
}

# One line per account: "A: someone@example.com · Example Inc (Claude Team account)" or "A: not logged in".
# A personal plan's organization is named "<email>'s Organization"; shown as "personal".
show_who() {
  local acct out org
  for acct in $ACCOUNTS; do
    out=$(CLAUDE_CONFIG_DIR=$HOME/.claude-$acct "$CLAUDE_BIN" auth status --text 2>&1)
    if grep -q '^Email:' <<<"$out"; then
      org=$(sed -n 's/^Organization: //p' <<<"$out")
      case $org in *"'s Organization") org=personal ;; esac
      echo "$(upper "$acct"): $(sed -n 's/^Email: //p' <<<"$out")${org:+ · $org} ($(sed -n 's/^Login method: //p' <<<"$out"))"
    else
      echo "$(upper "$acct"): not logged in"
    fi
  done
}

# Close the empty-profile sign-in windows that signin-browser.sh opened, and delete their profiles.
close_signin_browser() {
  pkill -f -- '--user-data-dir=.*aisw-login\.' 2>/dev/null || true
  rm -rf "${TMPDIR:-/tmp}"/aisw-login.*
}

# Email to pre-fill on the sign-in page: the account's current login, else the one saved last time,
# else asked once. Kept in $STATE/<x>.email on this Mac only.
login_email() {
  local acct=$1 email
  email=$(CLAUDE_CONFIG_DIR=$HOME/.claude-$acct "$CLAUDE_BIN" auth status --text 2>/dev/null | sed -n 's/^Email: //p')
  [ -n "$email" ] || email=$(cat "$STATE/$acct.email" 2>/dev/null)
  if [ -z "$email" ] && [ -t 0 ]; then read -rp "Email for account $(upper "$acct") (Enter to skip): " email; fi
  echo "$email"
}

# login_one <a|b|c> [claude auth login args...]: without args, pre-fills the email from login_email.
login_one() {
  local acct=$1 email code
  shift
  if [ $# -eq 0 ]; then
    email=$(login_email "$acct")
    if [ -n "$email" ]; then set -- --email "$email"; fi
  fi
  echo "== Account $(upper "$acct")${email:+ ($email)}: sign in in the new browser window"
  CLAUDE_CONFIG_DIR=$HOME/.claude-$acct "$CLAUDE_BIN" auth login "$@"
  code=$?
  close_signin_browser
  email=$(CLAUDE_CONFIG_DIR=$HOME/.claude-$acct "$CLAUDE_BIN" auth status --text 2>/dev/null | sed -n 's/^Email: //p')
  if [ -n "$email" ]; then echo "$email" > "$STATE/$acct.email"; fi
  return $code
}

do_login() {
  local acct code=0
  # The sign-in page opens in an empty browser profile, so no existing Claude login is reused.
  export BROWSER
  BROWSER=${AISW_BROWSER:-$(dirname "$0")/signin-browser.sh} # AISW_BROWSER: tests only
  case ${1:-} in
    codex|agy)
      # One step: a successful login also puts the tool on the fallback list (off: aisw unsetup --codex|--agy).
      if "${1}_login" && fallback_logged_in "$1"; then
        fallback_enabled "$1" || { fallback_add "$1"; echo "$(tool_label "$1") added as a fallback (off: aisw unsetup --$1)."; }
      else
        code=1
      fi
      ;;
    a|b|c) login_one "$@" || code=1 ;;
    "")
      for acct in $ACCOUNTS; do
        show_who | grep -q "^$(upper "$acct"): not logged in" || continue
        login_one "$acct" || return 1
      done
      ;;
    *) echo "usage: aisw login [a|b|c|codex|agy] [claude auth login args...]" >&2; return 1 ;;
  esac
  show_who
  fallback_who
  return $code
}

# AISW_UI replaces the dashboard command, for tests.
ui_cmd() {
  if [ -n "${AISW_UI:-}" ]; then "$AISW_UI"; else uv run --quiet --script "$(dirname "$0")/ui.py"; fi
}

# The TUI quits to start or log in (both need the whole terminal) and leaves "start a" / "login b" in a file.
run_ui() {
  local result choice
  result=$(mktemp)
  while :; do
    : > "$result"
    AISW_UI_RESULT=$result ui_cmd || break
    choice=$(cat "$result")
    case $choice in
      "start "[abc]) rm -f "$result"; exec "$0" claude "${choice#start }" ;;
      "login "[abc]) do_login "${choice#login }" ;;
      *) break ;;
    esac
  done
  rm -f "$result"
}

# First real thing the user typed in a session file (skips meta lines and <command…> wrappers).
FIRST_MESSAGE='first(inputs | select(.type == "user" and (.isMeta | not)) | .message.content
  | if type == "string" then . else (map(select(.type == "text").text) | first // empty) end
  | select(startswith("<") | not)) | gsub("\\s+"; " ") | .[0:100]'

list_sessions() {
  local f cwd msg
  ls -t "$HOME"/.claude/projects/*/*.jsonl 2>/dev/null | head -300 | while read -r f; do
    cwd=$(jq -nr 'first(inputs | .cwd // empty)' "$f" 2>/dev/null)
    [ -n "$cwd" ] || continue
    msg=$(jq -nr "$FIRST_MESSAGE" "$f" 2>/dev/null)
    printf '%s\t%s\t%-16s  %-28s  %s\n' "$f" "$cwd" "$(date -r "$f" '+%a %m-%d %H:%M')" \
      "${cwd/#$HOME/~}" "${msg:-(no message)}"
  done
}

pick_session() {
  local fzf=${AISW_FZF:-fzf} line f cwd
  line=$(list_sessions | "$fzf" --delimiter='\t' --with-nth=3 --no-sort --query="$*" \
    --prompt='resume> ' --header='enter: resume on the first free account · esc: cancel' \
    --preview="jq -r 'select(.type == \"user\" and (.isMeta | not)) | .message.content | strings
      | select(startswith(\"<\") | not)' {1} | head -40" --preview-window=down,40%,wrap) || return 1
  f=$(cut -f1 <<<"$line"); cwd=$(cut -f2 <<<"$line")
  cd "$cwd" || { echo "Folder is gone: $cwd" >&2; return 1; }
  exec "$0" claude --resume "$(basename "$f" .jsonl)"
}

show_help() {
  cat <<'EOF2'
aisw (AI switch): keep coding when an AI agent hits its usage limit: next Claude account, then Codex

aisw alone: dashboard. Start agents:
  aisw claude                first free Claude account, A → B → C
  aisw claude a|b|c          force an account
  aisw claude --continue     any Claude Code option passes through (--resume, -n name, ...)
  aisw claude --dry-run      print which account would start
  aisw codex | agy           hand this folder's newest Claude session to Codex / Antigravity now
  (alias claude='aisw claude' lets you type claude instead; aisw a|b|c still works)

Accounts:
  aisw who                   login, owner and plan of each account
  aisw status                free, or used up until when (with usage %)
  aisw ui (or aisw)          dashboard (←→ select, enter start, l login, r reset, q quit)
  aisw resume [words]        find any past conversation with fzf and resume it
  aisw login [a|b|c]         log in a Claude account (empty browser window, email pre-filled)
  aisw login codex | agy     log in Codex / Antigravity; that also makes it a fallback

Setup and testing:
  aisw setup | unsetup       add / remove account folders, status line and limit hook
  aisw setup --codex | --agy turn a fallback on, in the order you add them (unsetup --codex|--agy: off)
  aisw test-hit a|b|c [dir]  pretend an account just hit its limit

Fallbacks (turned on by aisw login codex / agy; off: aisw unsetup --codex / --agy):
  all Claude accounts used up → a menu: Codex, Antigravity, a Claude account anyway, or stop
  (Codex/Antigravity get a handoff note); aisw codex / aisw agy hand over right away

When a limit is hit: wait for the notification, type /exit, it goes on in the next account.
Claude Code's own help: claude --help (or command claude --help). Docs: github.com/mbshin/aisw
EOF2
}

# aisw alone opens the dashboard; aisw claude, a|b|c or -options start Claude.
[ $# -eq 0 ] && { run_ui; exit; }
dry=0 acct=
if [ "$1" = --dry-run ]; then dry=1; shift; fi
case ${1:-} in
  help|-h) show_help; exit 0 ;;
  status) show_status; exit 0 ;;
  who) show_who; fallback_who; exit 0 ;;
  codex|agy) go_tool "$1" "$(newest_session_in "$PWD")" "$PWD"; exit ;;
  login) shift; do_login "$@"; exit ;;
  ui|u) run_ui; exit ;;
  resume) shift; pick_session "$@"; exit ;;
  setup) shift; . "$(dirname "$0")/admin.sh"; do_setup "$@"; exit ;;
  unsetup) shift; . "$(dirname "$0")/admin.sh"; do_unsetup "$@"; exit ;;
  test-hit) shift; . "$(dirname "$0")/admin.sh"; do_test_hit "$@"; exit ;;
  claude) shift ;;
esac
if [ "${1:-}" = --dry-run ]; then dry=1; shift; fi
case ${1:-} in a|b|c) acct=$1; shift ;; esac
if [ "${1:-}" = --dry-run ]; then dry=1; shift; fi
if [ -z "$acct" ]; then
  acct=$(pick_account) || {
    echo "All accounts are at their limit:" >&2
    show_status >&2
    case $(choose_when_used_up) in
      codex) go_tool codex "$(newest_session_in "$PWD")" "$PWD"; exit ;;
      agy) go_tool agy "$(newest_session_in "$PWD")" "$PWD"; exit ;;
      a) acct=a ;;
      b) acct=b ;;
      c) acct=c ;;
      *) echo "Stopped. Later: aisw claude, or force one with aisw claude a|b|c" >&2; exit 1 ;;
    esac
  }
fi

while :; do
  dir=$HOME/.claude-$acct
  if [ ! -d "$dir" ]; then
    echo "Missing $dir: run aisw setup." >&2
    exit 1
  fi
  if [ "$dry" = 1 ]; then
    echo "CLAUDE_CONFIG_DIR=$dir $CLAUDE_BIN $*"
    exit 0
  fi

  started=$(now)
  CLAUDE_CONFIG_DIR=$dir "$CLAUDE_BIN" "$@"
  code=$?

  # Go on only when this run's account left a handoff (on-limit.sh) during this run.
  [ -f "$STATE/handoff.json" ] || exit $code
  read -r from at sid cwd < <(jq -r '[.from, .at, .session_id, .cwd] | @tsv' "$STATE/handoff.json")
  rm -f "$STATE/handoff.json"
  if [ "$from" != "$acct" ] || [ "$at" -lt "$started" ]; then exit $code; fi

  next=$(pick_account) || {
    echo "All accounts are at their limit:" >&2
    show_status >&2
    case $(choose_when_used_up) in
      codex) go_tool codex "$(session_file "$sid")" "$cwd"; exit ;;
      agy) go_tool agy "$(session_file "$sid")" "$cwd"; exit ;;
      a) next=a ;;
      b) next=b ;;
      c) next=c ;;
      *) echo "Resume later with: aisw claude --resume $sid" >&2; exit $code ;;
    esac
  }
  echo "$(upper "$acct") hit its limit. Going on in $(upper "$next") in ${WAIT}s (Ctrl+C to stop)..."
  sleep "$WAIT" || exit $code
  cd "$cwd" || exit 1
  acct=$next
  set -- --resume "$sid" "$RESUME_PROMPT"
done
