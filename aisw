#!/usr/bin/env bash
# aisw: one list of AI accounts (Claude Code, Codex, Antigravity); pick the current one and start it.
#
#   aisw [options]                 start the current account's AI CLI (claude, codex, agy); options pass through
#   aisw list                      dashboard of every account (a plain table when piped)
#   aisw add claude|codex|agy [name]  new account, signed in right away
#   aisw login <name>              sign an account in again
#   aisw remove <name>             take an account off the list (folder and login stay)
#   aisw activate <name>           make it the current account of this shell (and of new shells)
#   aisw deactivate                no current account: plain claude / codex use their own login again
#   aisw help                      this list
# Hidden: aisw shell-init zsh|bash (the ~/.zshrc line), aisw __names (Tab completion), aisw --version.
. "$(dirname "$0")/common.sh"
. "$(dirname "$0")/tools.sh"

VERSION=2.0.0
COMMANDS="list add login remove activate deactivate help"
RC_LINE='command -v aisw >/dev/null && eval "$(aisw shell-init zsh)"'
RC_COMMENT='# aisw: lets `aisw activate` change this shell'

# --- current account -------------------------------------------------------------------------------

# This shell's account (set by activate), else the one remembered for new shells.
current() {
  if has_account "${AISW_ACCOUNT:-}"; then echo "$AISW_ACCOUNT"; return; fi
  local c
  c=$(cat "$STATE/current" 2>/dev/null)
  if has_account "$c"; then echo "$c"; fi
}

# Shell lines that make <name> current (or none current, without a name).
env_lines() {
  local name=${1:-} tool dir
  if [ -z "$name" ]; then
    echo "unset AISW_ACCOUNT CLAUDE_CONFIG_DIR CODEX_HOME"
    return
  fi
  tool=$(tool_of "$name"); dir=$(folder_of "$name")
  printf 'export AISW_ACCOUNT=%q\n' "$name"
  case $tool in
    claude) printf 'export CLAUDE_CONFIG_DIR=%q\nunset CODEX_HOME\n' "$dir" ;;
    codex)
      echo "unset CLAUDE_CONFIG_DIR"
      if [ "$dir" = "$HOME/.codex" ]; then echo "unset CODEX_HOME"; else printf 'export CODEX_HOME=%q\n' "$dir"; fi
      ;;
    *) echo "unset CLAUDE_CONFIG_DIR CODEX_HOME" ;;
  esac
}

# Hand the lines to the calling shell: the shell-init function sources $STATE/env.<its pid> after aisw
# exits. Without it (no ~/.zshrc line yet), print them for eval when piped, else explain.
apply_env() {
  if [ -n "${AISW_SHELL_PID:-}" ]; then
    env_lines "$@" > "$STATE/env.$AISW_SHELL_PID"
  elif [ ! -t 1 ]; then
    env_lines "$@"
  else
    echo "This shell can't be changed without aisw's ~/.zshrc line. For now: eval \"\$(aisw ${1:+activate $1}${1:-deactivate})\"" >&2
    echo "(the line is added by aisw add / aisw login, or by hand: $RC_LINE)" >&2
  fi
}

do_activate() {
  local name=${1:-}
  if [ -z "$name" ]; then echo "usage: aisw activate <name>   (names: $(names | tr '\n' ' '))" >&2; return 1; fi
  if ! has_account "$name"; then unknown_account "$name"; return 1; fi
  echo "$name" > "$STATE/current"
  apply_env "$name"
  [ -t 1 ] || [ -n "${AISW_SHELL_PID:-}" ] || return 0
  echo "$name is the current account ($(tool_label "$(tool_of "$name")")). Start it: aisw" >&2
}

do_deactivate() {
  rm -f "$STATE/current"
  apply_env
  [ -t 1 ] || [ -n "${AISW_SHELL_PID:-}" ] || return 0
  echo "No current account: plain claude / codex use their own login again." >&2
}

unknown_account() {
  local hint=
  case $1 in
    claude|codex|codex[0-9]|agy) hint=" Accounts have names now (aisw list); new one: aisw add ${1%%[0-9]*}" ;;
  esac
  echo "No account named '$1'.$hint" >&2
}

# --- start the current account's AI CLI ------------------------------------------------------------

launch() {
  local name tool dir bin
  name=$(current)
  if [ -z "$name" ]; then
    if [ -s "$ACCOUNTS_FILE" ]; then
      echo "No current account. Pick one: aisw activate <name>   (names: $(names | tr '\n' ' '))" >&2
    else
      echo "No accounts yet. Add one: aisw add claude|codex|agy" >&2
    fi
    return 1
  fi
  tool=$(tool_of "$name"); dir=$(folder_of "$name"); bin=$(tool_bin "$tool")
  tool_missing "$tool" && return 1
  if [ "$tool" = claude ] && [ ! -d "$dir" ]; then echo "Missing $dir: aisw login $name" >&2; return 1; fi
  # Codex continues the last conversation with `codex resume --last`, not --continue.
  if [ "$tool" = codex ] && { [ "${1:-}" = --continue ] || [ "${1:-}" = -c ]; }; then
    shift; set -- resume --last "$@"
  fi
  export AISW_ACCOUNT=$name
  in_folder "$tool" "$dir" "$bin" "$@"
}

# --- list ------------------------------------------------------------------------------------------

pct() { jq -r ".$1.used_percentage // empty | floor | \"\\(.)%\"" "$STATE/$2.usage.json" 2>/dev/null; }

list_plain() {
  local cur name tool dir login plan state until f5 f7 mark
  cur=$(current)
  if [ ! -s "$ACCOUNTS_FILE" ]; then echo "No accounts yet. Add one: aisw add claude|codex|agy"; return 0; fi
  printf '  %-6s %-7s %-30s %-6s %-18s %-5s %s\n' NAME TOOL LOGIN PLAN STATE 5H 7D
  while read -r name tool dir; do
    login=- plan=- f5=- f7=-
    case $tool in
      claude)
        IFS=$'\t' read -r login plan _ < <(claude_login "$dir")
        if [ -z "$login" ]; then login=- plan=- state="not signed in"
        elif until=$(blocked_until "$name") && [ -n "$until" ]; then state="used up → $(date -r "$until" +%H:%M)"
        else state=free; fi
        f5=$(pct five_hour "$name"); f7=$(pct seven_day "$name")
        ;;
      codex) login=ChatGPT; if codex_signed_in "$dir"; then state="signed in"; else state="not signed in"; fi ;;
      agy) login=Google; if agy_signed_in; then state="signed in"; else state="not signed in"; fi ;;
    esac
    mark=" "; [ "$name" = "$cur" ] && mark="*"
    printf '%s %-6s %-7s %-30s %-6s %-18s %-5s %s\n' "$mark" "$name" "$tool" "${login:--}" "${plan:--}" "$state" \
      "${f5:--}" "${f7:--}"
  done < "$ACCOUNTS_FILE"
}

# AISW_UI replaces the dashboard command, for tests.
ui_cmd() {
  if [ -n "${AISW_UI:-}" ]; then "$AISW_UI"; else uv run --quiet --script "$(dirname "$0")/ui.py"; fi
}

# The dashboard quits for anything that needs the terminal and leaves "<action> <name>" in a file.
do_list() {
  if [ ! -t 1 ] || [ ! -t 0 ] || { [ -z "${AISW_UI:-}" ] && ! command -v uv >/dev/null; }; then
    list_plain
    return
  fi
  local result choice tool
  result=$(mktemp)
  while :; do
    : > "$result"
    AISW_UI_RESULT=$result AISW_CURRENT=$(current) ui_cmd || break
    choice=$(cat "$result")
    case $choice in
      "launch "*) rm -f "$result"; do_activate "${choice#launch }" 2>/dev/null; launch; return ;;
      "activate "*) do_activate "${choice#activate }"; break ;;
      "login "*) do_login "${choice#login }" ;;
      "remove "*) do_remove "${choice#remove }" ;;
      add)
        read -rp "Add which tool (claude, codex, agy)? " tool
        [ -n "$tool" ] && do_add "$tool"
        ;;
      *) break ;;
    esac
  done
  rm -f "$result"
}

# --- add / login / remove --------------------------------------------------------------------------

backup() { cp "$1" "$1.bak-$(date +%Y%m%d-%H%M%S)" && echo "  backup: $1.bak-…"; }

# Where the hooks should point: Homebrew's stable opt/ path, so upgrades don't break settings.json.
lib_dir() {
  local lib
  lib=$(cd "$(dirname "$0")" && pwd)
  case $lib in */Cellar/aisw/*/libexec) lib=${lib%%/Cellar/*}/opt/aisw/libexec ;; esac
  echo "$lib"
}

rc_file() { case ${SHELL:-} in *bash) echo "$HOME/.bashrc" ;; *) echo "$HOME/.zshrc" ;; esac; }

setup_done() {
  local settings=$HOME/.claude/settings.json
  jq -e '(.statusLine.command // "" | endswith("/statusline.sh"))
    and ([.hooks.StopFailure[]?.hooks[]?.command] | any(endswith("/on-limit.sh")))' "$settings" >/dev/null 2>&1 \
    && grep -qF "aisw shell-init" "$(rc_file)" 2>/dev/null
}

# Once, on the first add or login: the status line + limit hook (shared by every Claude account) and
# the shell line. Asks first (Enter = yes); a "no" is remembered.
ensure_setup() {
  local ans settings=$HOME/.claude/settings.json rc lib
  setup_done && return 0
  [ -f "$STATE/setup-declined" ] && return 0
  rc=$(rc_file)
  if [ -t 0 ]; then
    echo "First time: aisw adds its status line and limit hook to ~/.claude/settings.json and one line to"
    read -rp "${rc/#$HOME/~} (so aisw activate can change the shell). OK? [Y/n] " ans
    case $ans in n|N|no) touch "$STATE/setup-declined"; return 0 ;; esac
  fi
  lib=$(lib_dir)
  mkdir -p "$HOME/.claude/projects" "$HOME/.claude/skills" "$HOME/.claude/plugins"
  [ -f "$settings" ] || echo '{}' > "$settings"
  backup "$settings"
  jq --arg sl "$lib/statusline.sh" --arg hook "$lib/on-limit.sh" '
    .statusLine = {type: "command", command: $sl}
    | .hooks.StopFailure = ((.hooks.StopFailure // [])
        | map(select(([.hooks[]?.command] | any(endswith("/on-limit.sh"))) | not))
        + [{matcher: "rate_limit", hooks: [{type: "command", command: $hook}]}])
  ' "$settings" > "$settings.tmp" && mv "$settings.tmp" "$settings"
  echo "  ~/.claude/settings.json: status line and limit hook"
  if ! grep -qF "aisw shell-init" "$rc" 2>/dev/null; then
    [ -f "$rc" ] && backup "$rc"
    case $rc in *bashrc) printf '\n%s\n%s\n' "$RC_COMMENT" "${RC_LINE/zsh/bash}" >> "$rc" ;;
      *) printf '\n%s\n%s\n' "$RC_COMMENT" "$RC_LINE" >> "$rc" ;; esac
    echo "  ${rc/#$HOME/~}: aisw line (open a new terminal for aisw activate)"
  fi
}

SHARED="projects settings.json skills plugins"

# A Claude account folder shares conversations, settings, skills and plugins with ~/.claude.
make_claude_folder() {
  local n
  mkdir -p "$1"
  for n in $SHARED; do ln -sfn "$HOME/.claude/$n" "$1/$n"; done
}

valid_name() {
  [[ $1 =~ ^[a-z0-9][a-z0-9_-]{0,15}$ ]] || { echo "Names: lowercase letters, digits, - and _ (up to 16)." >&2; return 1; }
  case " $COMMANDS $TOOLS default main " in *" $1 "*) echo "'$1' is a command or tool name." >&2; return 1 ;; esac
  if has_account "$1"; then echo "There is already an account named '$1'." >&2; return 1; fi
}

next_letter() {
  local l
  for l in {a..z}; do has_account "$l" || { echo "$l"; return; }; done
  return 1
}

do_add() {
  local tool=${1:-} name=${2:-} dir made=
  case " $TOOLS " in *" $tool "*) ;; *) echo "usage: aisw add claude|codex|agy [name]" >&2; return 1 ;; esac
  if [ -n "$name" ]; then valid_name "$name" || return 1; else name=$(next_letter) || return 1; fi
  tool_missing "$tool" && return 1
  case $tool in
    claude) dir=$STATE/home/$name ;;
    codex)
      dir=$HOME/.codex
      if [ -n "$(names_of_tool codex)" ] && awk '$2 == "codex"' "$ACCOUNTS_FILE" | grep -q " $HOME/.codex$"; then
        dir=$STATE/home/$name
      fi
      ;;
    agy)
      if [ -n "$(names_of_tool agy)" ]; then
        echo "Only one Antigravity account for now ($(names_of_tool agy)): a second one isn't supported yet." >&2
        return 1
      fi
      dir=$HOME/.gemini/antigravity-cli
      ;;
  esac
  ensure_setup
  if [ ! -d "$dir" ]; then made=1; fi
  case $tool in claude) make_claude_folder "$dir" ;; codex) mkdir -p "$dir" ;; esac
  if signed_in "$tool" "$dir"; then
    echo "$name: already signed in."
  elif ! sign_in "$name" "$tool" "$dir"; then
    echo "Sign-in didn't finish: $name not added." >&2
    if [ -n "$made" ] && [ "${dir#"$STATE"/home/}" != "$dir" ]; then rm -rf "$dir"; fi
    return 1
  fi
  echo "$name $tool $dir" >> "$ACCOUNTS_FILE"
  echo "Added $name ($(tool_label "$tool")). Use it: aisw activate $name"
}

do_login() {
  local name=${1:-} tool dir ans
  if [ -z "$name" ]; then echo "usage: aisw login <name>   (names: $(names | tr '\n' ' '))" >&2; return 1; fi
  if ! has_account "$name"; then unknown_account "$name"; return 1; fi
  tool=$(tool_of "$name"); dir=$(folder_of "$name")
  ensure_setup
  if [ "$tool" != claude ] && signed_in "$tool" "$dir"; then
    # A new Codex sign-in replaces the old one, and a cancelled one leaves it logged out: ask first.
    if [ "$tool" = agy ] || [ ! -t 0 ]; then echo "$name: already signed in."; return 0; fi
    read -rp "$name is signed in. Sign in again? [y/N] " ans
    case $ans in y|Y|yes) ;; *) return 0 ;; esac
  fi
  [ "$tool" = claude ] && make_claude_folder "$dir"
  sign_in "$name" "$tool" "$dir"
}

do_remove() {
  local name=${1:-} dir
  if [ -z "$name" ]; then echo "usage: aisw remove <name>" >&2; return 1; fi
  if ! has_account "$name"; then unknown_account "$name"; return 1; fi
  dir=$(folder_of "$name")
  awk -v n="$name" '$1 != n' "$ACCOUNTS_FILE" > "$ACCOUNTS_FILE.tmp" && mv "$ACCOUNTS_FILE.tmp" "$ACCOUNTS_FILE"
  [ "$(cat "$STATE/current" 2>/dev/null)" = "$name" ] && rm -f "$STATE/current"
  rm -f "$STATE/$name".{limit,usage.json,warned,email}
  echo "Removed $name. Its folder and login stay in ${dir/#$HOME/~}."
}

# --- shell integration, completion, help -----------------------------------------------------------

# `eval "$(aisw shell-init zsh)"` in ~/.zshrc: an aisw function that applies activate/deactivate to this
# shell, then the account remembered for new shells. Works in zsh and bash.
shell_init() {
  cat <<'EOF2'
aisw() {
  local _aisw_rc _aisw_env="${AISW_STATE:-$HOME/.aisw}/env.$$"
  AISW_SHELL_PID=$$ command aisw "$@"
  _aisw_rc=$?
  if [ -f "$_aisw_env" ]; then . "$_aisw_env"; rm -f "$_aisw_env"; fi
  return $_aisw_rc
}
EOF2
  local c
  c=$(cat "$STATE/current" 2>/dev/null)
  if has_account "$c"; then env_lines "$c"; fi
}

# For Tab completion: "<name>:<tool> <email>" per account; fast, from saved files only.
completion_names() {
  local name tool dir
  while read -r name tool dir; do
    echo "$name:$tool $(cat "$STATE/$name.email" 2>/dev/null)"
  done < "$ACCOUNTS_FILE" 2>/dev/null
}

show_help() {
  cat <<EOF2
aisw $VERSION: one list of AI accounts (Claude Code, Codex, Antigravity). Pick one, start it.

  aisw [options]                    start the current account's AI CLI (claude, codex, agy);
                                    options pass through: aisw --continue
  aisw list                         every account: login, plan, state, usage (* = current)
                                    dashboard keys: ←→ select, a activate, enter start, l login,
                                    n add, d remove, q quit
  aisw add claude|codex|agy [name]  new account (next free letter, or the name), signed in right away
  aisw login <name>                 sign an account in again
  aisw remove <name>                take an account off the list (folder and login stay)
  aisw activate <name>              make it the current account (this shell and new ones);
                                    plain claude / codex use it too
  aisw deactivate                   no current account: plain claude / codex use their own login
  aisw help                         this help

When an account hits its limit, the notification names the next free one:
  /exit, aisw activate <next>, aisw --continue
Docs: github.com/mbshin/aisw
EOF2
}

removed() {
  echo "aisw $1 was removed in 2.0. $2" >&2
  return 2
}

# --- main ------------------------------------------------------------------------------------------

case ${1:-} in
  ""|-*)
    case ${1:-} in
      --version|-V) echo "aisw $VERSION"; exit 0 ;;
      -h|--help) show_help; exit 0 ;;
      --) shift ;;
    esac
    launch "$@"; exit
    ;;
  list|ls) do_list ;;
  add) shift; do_add "$@" ;;
  login) shift; do_login "$@" ;;
  remove|rm) shift; do_remove "$@" ;;
  activate) shift; do_activate "$@" ;;
  deactivate) do_deactivate ;;
  help) show_help ;;
  version) echo "aisw $VERSION" ;;
  shell-init) shell_init ;;
  __names) completion_names ;;
  claude|codex|agy|codex[0-9]) removed "$1" "Pick the account, then start it: aisw activate <name>; aisw" ;;
  who|status|ui|u) removed "$1" "Use: aisw list" ;;
  resume) removed "$1" "Use: aisw --resume (Claude Code's own picker)" ;;
  setup|unsetup) removed "$1" "aisw add / aisw login set things up the first time." ;;
  test-hit|next) removed "$1" "" ;;
  *) echo "Unknown command '$1'. aisw help lists them; to pass words to the AI CLI: aisw -- $*" >&2; exit 2 ;;
esac
